# Open roadmap — backend + auth config.
# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables). Without the Supabase vars, the
# roadmap renders in read-only "preview mode" from static seed data.

# ── Supabase (roadmap data: ideas + votes) ───────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — NEVER expose. Used by API routes to write (create/vote/delete).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin auth (delete) ──────────────────────────────────────────────────────
# Shared password to enter admin mode (reveals delete buttons). Server-only.
# Pick something long; generate with: openssl rand -hex 16
ROADMAP_ADMIN_PASSWORD=replace-with-a-long-password
